# ---------------------------------------------------------------------------
# Spaghetti Lab environment
#
# Copy to .env.local for local development. On Vercel, set the VITE_* vars in
# Project Settings -> Environment Variables. The server-only secrets below
# belong to Supabase Edge Functions (`supabase secrets set ...`) and are never
# exposed to the browser.
# ---------------------------------------------------------------------------

# --- Browser (safe to ship; VITE_ vars are inlined into the bundle) --------
VITE_SITE_URL=https://spaghettilab.store
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Square Web Payments SDK. The application id and location id are public by
# design; the access token below is not.
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENVIRONMENT=sandbox   # sandbox | production

# --- Supabase Edge Function secrets (server-only) --------------------------
# Set with: supabase secrets set --env-file .env.local
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime; they are listed here only for scripts/square-catalog-seed.mjs.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must byte-match the URL registered in the Square dashboard.
SQUARE_WEBHOOK_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/square-webhook

RESEND_API_KEY=
RESEND_FROM=Spaghetti Lab <no-reply@spaghettilab.store>
RESEND_REPLY_TO=hello@spaghettilab.store
# New-order alerts for the kitchen.
KITCHEN_EMAIL=

SITE_URL=https://spaghettilab.store

# Optional. Without a key, delivery addresses are geocoded with the free,
# keyless US Census geocoder.
GOOGLE_MAPS_API_KEY=
